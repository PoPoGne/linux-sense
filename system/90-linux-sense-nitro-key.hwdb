# Linux Sense: special keys on the Acer Nitro AN14-41.
#
# 0xf5 NitroSense key ("N"): by default it becomes code 425, which KDE cannot
#      use for shortcuts. We remap it to prog1 (XF86Launch1), bound in KDE
#      to opening Linux Sense.
# 0xef Fn+F12 / 0xf0 Fn+F11, keyboard brightness: the generic Acer rule
#      turns 0xef into "screen brightness down". We remap them to the backlight
#      key codes: the daemon replaces the firmware step with 5% steps (the Plasma
#      shortcuts are disabled). The keyboard does not send the release event for
#      these two keys: "!" makes the driver generate it (force_release), otherwise
#      they stay "pressed" and only the first press is seen.
evdev:atkbd:dmi:*:svnAcer:pnNitroAN14-41:*
 KEYBOARD_KEY_f5=prog1
 KEYBOARD_KEY_ef=!kbdillumup
 KEYBOARD_KEY_f0=!kbdillumdown
